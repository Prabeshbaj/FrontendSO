# Copy to .env.local and fill in. Never commit real values.
# Okta (D-05a). Issuer and audience depend on open item O-12.
VITE_OKTA_ISSUER=https://your-okta-domain/oauth2/default
VITE_OKTA_CLIENT_ID=replace-me
VITE_OKTA_SCOPES=openid profile email
# API Gateway HTTP API base URL (architecture-v2, component 3)
VITE_API_BASE_URL=https://api.example.internal
# Optional: URL of a stylesheet with the licensed brand @font-face rules.
# Leave empty to render with the Arial fallback. Do not commit font files.
VITE_BRAND_FONT_CSS_URL=
VITE_BRAND_FONT_FAMILY=FF Mark
# "okta" (default) or "mock" (local only, synthetic user, MSW mock API)
VITE_AUTH_MODE=okta
